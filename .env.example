APP_NAME="WhatsApp Commerce for SMEs"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wc.vigourtech.net
APP_TIMEZONE=Africa/Dar_es_Salaam

LOG_CHANNEL=stack
LOG_LEVEL=info

# cPanel/MySQL defaults
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_wc
DB_USERNAME=cpaneluser_wcapi
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# cPanel-safe defaults. Redis can be enabled later on VPS/managed hosting.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

SANCTUM_EXPIRATION=10080

WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_EMBEDDED_SIGNUP_CALLBACK_URL=https://wc.vigourtech.net
WHATSAPP_EMBEDDED_SIGNUP_REDIRECT_URI=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-long-random-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_ENFORCE_SIGNATURE=true
WHATSAPP_REQUEST_TIMEOUT=20

PAYMENT_PROVIDER=generic
PAYMENT_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=https://wc.vigourtech.net/api/webhooks/payments/generic

CORS_ALLOWED_ORIGINS=https://wc.vigourtech.net

AI_PROVIDER=deterministic
AI_API_KEY=
